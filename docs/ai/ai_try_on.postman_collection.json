        {
          "name": "Beğen / Beğeniyi Kaldır",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/products/like/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1\n}"
            },
            "description": "Ürünü beğen veya beğeniyi geri al (toggle).\n\nKullanıcı daha önce beğenmişse beğeni kaldırılır, beğenmemişse eklenir. Response'daki `liked` alanı işlem sonrası güncel durumu gösterir.\n\nBeğenme işlemi recommendation cache'ini de invalidate eder."
          },
          "response": [
            {
              "name": "Beğenildi (200)",
              "originalRequest": {
                "method": "POST",
